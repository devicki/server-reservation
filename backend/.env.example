# Database
# 로컬 PostgreSQL: 기본값 사용. DB가 안 떠 있으면 'alembic upgrade head' 시 연결 거부됨.
# Docker로 DB만 띄운 경우: docker compose up -d db 후 포트 15433 사용
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15433/server_reservation
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/server_reservation

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Calendar (optional)
# 상대 경로 사용 시 Docker·local 공유 가능. 예: credentials/key.json
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Reservation (예약 최대 허용 시간, 시간 단위. 기본 168 = 7일)
# MAX_RESERVATION_HOURS=168

# 서버 계정 예외 (시스템 기본, 예약 선택 목록에서 항상 제외. 수정·삭제 불가. 쉼표 구분)
# EXCLUDE_USERS=root,nobody,dev,admin,teleport,ubuntu

# Debug
DEBUG=true

# 최초 관리자 시드 (선택) - 설정 시 admin이 0명일 때만 이 계정으로 관리자 생성
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password

# 예약 이벤트 프로세스 (세션 스케줄러): WAS 서버에서는 true, 로컬 개발에서는 false 권장
RESERVATION_EVENT_PROCESS_ENABLED=true